<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Üst Kontrol Barı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnClueBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_card_neutral"
            android:contentDescription="Geri"
            android:rotation="90"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Şarkı Sözü &amp; İpucu Modu"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClueAttemptCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kalan Hak: 5"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- İPUCU KARTI -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_neutral"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="ŞARKI SÖZÜ / ALINTI"
                        android:textColor="@color/gold"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQuoteClue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="italic|bold"
                        tools:text="“Manifest'in sahnedeki ses tüneli ve lider vokali!”" />

                    <!-- Kademeli İpuçları Bölümü -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/surface_border" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Açılan Ek İpuçları (Yanlış Tahminle Açılır):"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvClueStage1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_card_neutral"
                        android:padding="10dp"
                        android:text="🔒 İpucu 1: 1. Yanlış Tahminde Açılır"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvClueStage2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_card_neutral"
                        android:padding="10dp"
                        android:text="🔒 İpucu 2: 2. Yanlış Tahminde Açılır"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvClueStage3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_card_neutral"
                        android:padding="10dp"
                        android:text="🔒 İpucu 3: 3. Yanlış Tahminde Açılır"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tahmin Giriş Alanı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <AutoCompleteTextView
                    android:id="@+id/autoCompleteClueInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_input"
                    android:completionThreshold="1"
                    android:hint="Bu T-Pop üyesi kim?"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSubmitClueGuess"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_gradient_button"
                    android:paddingHorizontal="16dp"
                    android:text="Cevapla"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Yanlış Tahmin Edilenler -->
            <TextView
                android:id="@+id/tvWrongGuessesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/mismatch_red"
                android:textSize="13sp"
                tools:text="Denenenler: Hilal Yelekçi ❌, Salman Tin ❌" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
